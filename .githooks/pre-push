#!/bin/sh
# git pre-push hook. Arguments: $1 remote name, $2 remote URL.
# stdin: one line per ref, "<local ref> <local sha> <remote ref> <remote sha>".
# Runs the publication gate over exactly the commits being pushed, against the
# URL actually being pushed to.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
gate="$here/../scripts/publication-gate.mjs"
url="$2"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;; # deleting a remote ref: nothing to scan
  esac
  # The gate resolves an all-zero remote sha (new remote ref) to the full history of the local sha.
  node "$gate" --range "$remote_sha..$local_sha" --remote-url "$url" </dev/null || status=1
done
exit $status
